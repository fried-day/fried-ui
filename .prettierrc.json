{
  "$schema": "https://www.schemastore.org/prettierrc.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "packages/styles/tailwind.css",
  "tailwindAttributes": ["className"],
  "tailwindFunctions": ["clsx", "classes"]
}

{
  "name": "fried-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "audit:deps": "pnpm audit --audit-level moderate",
    "build": "turbo build",
    "build:docs": "turbo build --filter=docs",
    "build:react": "turbo build --filter=@fried-ui/react",
    "build:storybook": "turbo build --filter=storybook",
    "build:styles": "turbo build --filter=@fried-ui/styles",
    "canary:publish": "turbo run canary:publish",
    "canary:version": "node scripts/canary-version.mjs",
    "changeset": "changeset",
    "changeset:pre:beta": "changeset pre enter beta",
    "changeset:pre:exit": "changeset pre exit",
    "changeset:pre:rc": "changeset pre enter rc",
    "changeset:release": "pnpm build && changeset publish",
    "changeset:version": "changeset version",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "clean:cache": "rm -rf .turbo node_modules/.cache",
    "clean:dist": "turbo clean",
    "clean:docs": "turbo clean --filter=docs",
    "clean:react": "turbo clean --filter=@fried-ui/react",
    "clean:storybook": "turbo clean --filter=storybook",
    "clean:styles": "turbo clean --filter=@fried-ui/styles",
    "dev": "turbo dev",
    "dev:docs": "turbo dev --filter=docs",
    "dev:react": "turbo dev --filter=@fried-ui/react",
    "dev:storybook": "turbo dev --filter=storybook",
    "dev:styles": "turbo dev --filter=@fried-ui/styles",
    "format": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,jsonc,yml,yaml,css,md,mdx}\"",
    "format:fix": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,jsonc,yml,yaml,css,md,mdx}\"",
    "preinstall": "npx only-allow pnpm",
    "lint": "turbo lint",
    "lint:docs": "turbo lint --filter=docs",
    "lint:fix": "turbo run lint:fix",
    "lint:react": "turbo lint --filter=@fried-ui/react",
    "lint:storybook": "turbo lint --filter=storybook",
    "lint:styles": "turbo lint --filter=@fried-ui/styles",
    "prepare": "husky",
    "release:preview": "pnpx pkg-pr-new publish --pnpm './packages/react' './packages/styles'",
    "sort": "turbo run sort",
    "sort:fix": "turbo run sort:fix",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo typecheck",
    "typecheck:docs": "turbo typecheck --filter=docs",
    "typecheck:react": "turbo typecheck --filter=@fried-ui/react",
    "typecheck:storybook": "turbo typecheck --filter=storybook",
    "typecheck:styles": "turbo typecheck --filter=@fried-ui/styles"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@repo/eslint-config": "workspace:*",
    "@turbo/gen": "^2.9.6",
    "@types/node": "^22.15.3",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sort-package-json": "^3.6.1",
    "stylelint": "^17.9.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "postcss": ">=8.5.10"
    }
  }
}

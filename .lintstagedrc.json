{
  "*.{ts,tsx,js,jsx,mjs}": [
    "prettier --write",
    "eslint --flag v10_config_lookup_from_file --fix --max-warnings 0 --no-warn-ignored"
  ],
  "*.css": ["prettier --write", "stylelint --fix --max-warnings 0"],
  "*.{md,mdx,json,jsonc,yml,yaml}": ["prettier --write"],
  "package.json": ["sort-package-json", "prettier --write"]
}

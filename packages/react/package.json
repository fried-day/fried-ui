{
  "name": "@fried-ui/react",
  "version": "0.1.0",
  "description": "Same component in React. Same class in HTML. One source of truth. Compound primitives, dual selectors, dark mode, and zero runtime.",
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwindcss",
    "react-aria",
    "accessible",
    "design-system"
  ],
  "homepage": "https://github.com/fried-day/fried-ui",
  "bugs": "https://github.com/fried-day/fried-ui/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/fried-day/fried-ui",
    "directory": "packages/react"
  },
  "license": "MIT",
  "author": "Joe Takara <anuchit.boonsom@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./avatar": {
      "types": "./dist/components/avatar/index.d.ts",
      "import": "./dist/components/avatar/index.mjs"
    },
    "./avatar-group": {
      "types": "./dist/components/avatar-group/index.d.ts",
      "import": "./dist/components/avatar-group/index.mjs"
    },
    "./badge": {
      "types": "./dist/components/badge/index.d.ts",
      "import": "./dist/components/badge/index.mjs"
    },
    "./button": {
      "types": "./dist/components/button/index.d.ts",
      "import": "./dist/components/button/index.mjs"
    },
    "./chip": {
      "types": "./dist/components/chip/index.d.ts",
      "import": "./dist/components/chip/index.mjs"
    },
    "./description": {
      "types": "./dist/components/description/index.d.ts",
      "import": "./dist/components/description/index.mjs"
    },
    "./field-error": {
      "types": "./dist/components/field-error/index.d.ts",
      "import": "./dist/components/field-error/index.mjs"
    },
    "./icons": {
      "types": "./dist/components/icons/index.d.ts",
      "import": "./dist/components/icons/index.mjs"
    },
    "./input": {
      "types": "./dist/components/input/index.d.ts",
      "import": "./dist/components/input/index.mjs"
    },
    "./label": {
      "types": "./dist/components/label/index.d.ts",
      "import": "./dist/components/label/index.mjs"
    },
    "./signal-dot": {
      "types": "./dist/components/signal-dot/index.d.ts",
      "import": "./dist/components/signal-dot/index.mjs"
    },
    "./surface": {
      "types": "./dist/components/surface/index.d.ts",
      "import": "./dist/components/surface/index.mjs"
    },
    "./textarea": {
      "types": "./dist/components/textarea/index.d.ts",
      "import": "./dist/components/textarea/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "canary:publish": "pnpm publish --tag canary --no-git-checks --access public",
    "clean": "rm -rf dist .turbo",
    "dev": "tsup --watch",
    "generate:component": "turbo gen react-component",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "sort": "sort-package-json --check",
    "sort:fix": "sort-package-json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node ../../scripts/normalize-lcov.mjs coverage/lcov.info",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fried-ui/assets": "workspace:*",
    "@fried-ui/styles": "workspace:^",
    "@radix-ui/react-avatar": "^1.1.11",
    "@react-types/color": "^3.1.4",
    "@react-types/shared": "^3.33.1",
    "clsx": "^2.1.1",
    "react-aria-components": "^1.16.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@storybook/react": "^10.3.3",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sort-package-json": "^3.6.1",
    "tailwindcss": "^4.2.2",
    "ts-morph": "^28.0.0",
    "tsup": "^8.5.1",
    "turbo": "^2.9.6",
    "typescript": "5.9.2",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}

{
  "name": "@fried-ui/styles",
  "version": "0.1.0",
  "description": "Pure CSS for Fried UI — same class in HTML, no React needed. Design tokens, component classes, dual selectors, dark mode.",
  "keywords": [
    "tailwindcss",
    "styles",
    "css",
    "design-system"
  ],
  "homepage": "https://github.com/fried-day/fried-ui",
  "bugs": "https://github.com/fried-day/fried-ui/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/fried-day/fried-ui",
    "directory": "packages/styles"
  },
  "license": "MIT",
  "author": "Joe Takara <anuchit.boonsom@gmail.com>",
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "canary:publish": "pnpm publish --tag canary --no-git-checks --access public",
    "clean": "rm -rf .turbo",
    "lint": "pnpm run lint:js && pnpm run lint:css",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
    "lint:fix": "pnpm lint:fix:js && pnpm lint:fix:css",
    "lint:fix:css": "stylelint \"src/**/*.css\" --fix --max-warnings 0",
    "lint:fix:js": "eslint . --fix --max-warnings 0",
    "lint:js": "eslint . --max-warnings 0",
    "sort": "sort-package-json --check",
    "sort:fix": "sort-package-json"
  },
  "dependencies": {
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@tailwindcss/cli": "^4.2.2",
    "eslint": "^10.2.1",
    "sort-package-json": "^3.6.1",
    "stylelint": "^17.9.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4.2.2"
  },
  "peerDependencies": {
    "tailwindcss": ">=4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}

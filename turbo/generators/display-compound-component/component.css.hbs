@layer components {
  .{{dashCase name}} {
    @apply relative inline-flex;
  }

  .{{dashCase name}}-item {
    @apply inline-flex items-center justify-center;
    @apply leading-none font-medium whitespace-nowrap select-none;

    --{{dashCase name}}-item-bg: var(--color-primary);
    --{{dashCase name}}-item-border: var(--color-primary-border);
    --{{dashCase name}}-item-fg: var(--color-primary-foreground);

    @apply bg-(--{{dashCase name}}-item-bg) text-(--{{dashCase name}}-item-fg);
    @apply border border-(--{{dashCase name}}-item-border);
    @apply h-8 gap-1.5 px-3 text-sm;
    @apply rounded-md;
  }

  .{{dashCase name}}-item-primary {
    --{{dashCase name}}-item-bg: var(--color-primary);
    --{{dashCase name}}-item-border: var(--color-primary-border);
    --{{dashCase name}}-item-fg: var(--color-primary-foreground);
  }

  .{{dashCase name}}-item-secondary {
    --{{dashCase name}}-item-bg: var(--color-secondary);
    --{{dashCase name}}-item-border: var(--color-secondary-border);
    --{{dashCase name}}-item-fg: var(--color-secondary-foreground);
  }

  .{{dashCase name}}-item-accent {
    --{{dashCase name}}-item-bg: var(--color-accent);
    --{{dashCase name}}-item-border: var(--color-accent-border);
    --{{dashCase name}}-item-fg: var(--color-accent-foreground);
  }

  .{{dashCase name}}-item-success {
    --{{dashCase name}}-item-bg: var(--color-success);
    --{{dashCase name}}-item-border: var(--color-success-border);
    --{{dashCase name}}-item-fg: var(--color-success-foreground);
  }

  .{{dashCase name}}-item-warning {
    --{{dashCase name}}-item-bg: var(--color-warning);
    --{{dashCase name}}-item-border: var(--color-warning-border);
    --{{dashCase name}}-item-fg: var(--color-warning-foreground);
  }

  .{{dashCase name}}-item-danger {
    --{{dashCase name}}-item-bg: var(--color-danger);
    --{{dashCase name}}-item-border: var(--color-danger-border);
    --{{dashCase name}}-item-fg: var(--color-danger-foreground);
  }

  .{{dashCase name}}-item-info {
    --{{dashCase name}}-item-bg: var(--color-info);
    --{{dashCase name}}-item-border: var(--color-info-border);
    --{{dashCase name}}-item-fg: var(--color-info-foreground);
  }

  .{{dashCase name}}-item-size-sm {
    @apply h-6 gap-1 px-2 text-xs;
  }

  .{{dashCase name}}-item-size-md {
    @apply h-8 gap-1.5 px-3 text-sm;
  }

  .{{dashCase name}}-item-size-lg {
    @apply h-10 gap-2 px-4 text-base;
  }
}

/*
 * Declare ONLY fried-ui-specific props (style/layout modifiers that map to CSS classes):
 *   variant, size, radius, isFullWidth, isPending, isIconOnly.
 *
 * Do NOT redeclare props that the underlying primitive (React Aria / native HTML) already
 * provides: isDisabled, isInvalid, isReadOnly, isRequired, disabled, readOnly, required,
 * aria-invalid. They flow through via the intersection type
 *   {Name}VariantsProps & Omit<ComponentPropsWithRef<Primitive>, "className" | "children">
 * See .claude/rules/architecture.md "Over-declare".
 */
export interface {{pascalCase name}}VariantsProps {
  /** Size scale. @default 'md' */
  size?: "sm" | "md" | "lg";
  /** Visual style. @default 'primary' */
  variant?: "primary" | "secondary" | "outline" | "ghost" | "destructive" | "overlay" | "accent";
}

@layer components {
  .{{dashCase name}} {
    @apply relative inline-flex items-center justify-center;
    @apply leading-none font-medium whitespace-nowrap;
    @apply cursor-pointer select-none no-highlight;
    @apply transition-colors duration-(--duration-hover) ease-out motion-reduce:transition-none;

    --{{dashCase name}}-bg: var(--color-primary);
    --{{dashCase name}}-bg-hover: var(--color-primary-hover);
    --{{dashCase name}}-bg-pressed: var(--color-primary-active);
    --{{dashCase name}}-border: var(--color-primary-border);
    --{{dashCase name}}-fg: var(--color-primary-foreground);

    @apply bg-(--{{dashCase name}}-bg) text-(--{{dashCase name}}-fg);
    @apply border border-(--{{dashCase name}}-border);
    @apply h-10 gap-2 px-4 text-base;
    @apply rounded-md;

    &:focus-visible,
    &[data-focus-visible] {
      @apply focus-ring;
    }

    &:disabled,
    &[data-disabled] {
      @apply status-disabled;
    }

    @media (hover: hover) {
      &:hover:not(:disabled):not(:active),
      &[data-hovered] {
        @apply bg-(--{{dashCase name}}-bg-hover);
      }
    }

    &:active:not(:disabled),
    &[data-pressed] {
      @apply bg-(--{{dashCase name}}-bg-pressed) duration-(--duration-press);
    }
  }

  /*
   * Variant classes — override tokens only (no @apply border-X-border).
   * Consumer overrides ANY of these tokens in their :root to theme globally.
   * Add new variants by defining the 5 tokens above (bg/bg-hover/bg-pressed/border/fg).
   * If a required token doesn't exist in packages/styles/src/tokens/colors.css, add it there first.
   */

  .{{dashCase name}}-primary {
    --{{dashCase name}}-bg: var(--color-primary);
    --{{dashCase name}}-bg-hover: var(--color-primary-hover);
    --{{dashCase name}}-bg-pressed: var(--color-primary-active);
    --{{dashCase name}}-border: var(--color-primary-border);
    --{{dashCase name}}-fg: var(--color-primary-foreground);
  }

  .{{dashCase name}}-secondary {
    --{{dashCase name}}-bg: var(--color-secondary);
    --{{dashCase name}}-bg-hover: var(--color-secondary-hover);
    --{{dashCase name}}-bg-pressed: var(--color-secondary-active);
    --{{dashCase name}}-border: var(--color-secondary-border);
    --{{dashCase name}}-fg: var(--color-secondary-foreground);
  }

  .{{dashCase name}}-outline {
    --{{dashCase name}}-bg: transparent;
    --{{dashCase name}}-bg-hover: var(--color-muted);
    --{{dashCase name}}-bg-pressed: var(--color-muted-hover);
    --{{dashCase name}}-border: var(--color-border);
    --{{dashCase name}}-fg: var(--color-foreground);
  }

  .{{dashCase name}}-ghost {
    --{{dashCase name}}-bg: transparent;
    --{{dashCase name}}-bg-hover: var(--color-muted);
    --{{dashCase name}}-bg-pressed: var(--color-muted-hover);
    --{{dashCase name}}-border: transparent;
    --{{dashCase name}}-fg: var(--color-foreground);
  }

  .{{dashCase name}}-destructive {
    --{{dashCase name}}-bg: var(--color-destructive);
    --{{dashCase name}}-bg-hover: var(--color-destructive-hover);
    --{{dashCase name}}-bg-pressed: var(--color-destructive-active);
    --{{dashCase name}}-border: var(--color-destructive-border);
    --{{dashCase name}}-fg: var(--color-destructive-foreground);
  }

  .{{dashCase name}}-overlay {
    --{{dashCase name}}-bg: var(--color-on-overlay);
    --{{dashCase name}}-bg-hover: var(--color-on-overlay-hover);
    --{{dashCase name}}-bg-pressed: var(--color-on-overlay-active);
    --{{dashCase name}}-border: var(--color-on-overlay-border);
    --{{dashCase name}}-fg: var(--color-on-overlay-foreground);
  }

  .{{dashCase name}}-accent {
    --{{dashCase name}}-bg: var(--color-accent);
    --{{dashCase name}}-bg-hover: var(--color-accent-hover);
    --{{dashCase name}}-bg-pressed: var(--color-accent-active);
    --{{dashCase name}}-border: var(--color-accent-border);
    --{{dashCase name}}-fg: var(--color-accent-foreground);
  }

  .{{dashCase name}} [slot="icon"],
  .{{dashCase name}} [slot="icon-start"],
  .{{dashCase name}} [slot="icon-end"] {
    @apply size-match-font;
  }

  .{{dashCase name}}-size-sm {
    @apply h-8 gap-1.5 px-3 text-sm;
  }

  .{{dashCase name}}-size-md {
    @apply h-10 gap-2 px-4 text-base;
  }

  .{{dashCase name}}-size-lg {
    @apply h-12 gap-2.5 px-6 text-xl;
  }

  .{{dashCase name}}-radius-none {
    @apply rounded-none;
  }

  .{{dashCase name}}-radius-sm {
    @apply rounded-sm;
  }

  .{{dashCase name}}-radius-md {
    @apply rounded-md;
  }

  .{{dashCase name}}-radius-lg {
    @apply rounded-lg;
  }

  .{{dashCase name}}-radius-full {
    @apply rounded-full;
  }
}

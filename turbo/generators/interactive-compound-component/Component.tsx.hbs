"use client";

import type { ComponentPropsWithRef, ReactNode } from "react";

import { Button as AriaComponent, composeRenderProps } from "react-aria-components";
import type { ButtonRenderProps } from "react-aria-components";

import { clsx } from "clsx";

import { classes } from "../../utils/classes";

export type {{pascalCase name}}Props = ComponentPropsWithRef<"div">;

/**
 * TODO: One-line description of what {{pascalCase name}} does. Acts as a positioning or composition
 * wrapper for its named interactive subparts (e.g. {{pascalCase name}}Item). Compose with subparts via
 * flat named imports — never dot notation.
 */
const {{pascalCase name}} = (props: Readonly<{{pascalCase name}}Props>) => {
  const { children, className, ref, ...rest } = props;

  const wrapperClassName = classes({
    block: "{{dashCase name}}",
    modifiers: {},
    className,
  });

  return (
    <div data-slot="{{dashCase name}}" className={wrapperClassName} ref={ref} {...rest}>
      {children}
    </div>
  );
};

{{pascalCase name}}.displayName = "{{pascalCase name}}";

export interface {{pascalCase name}}ItemProps
  extends Omit<ComponentPropsWithRef<typeof AriaComponent>, "className" | "children"> {
  children?: ReactNode | ((renderProps: ButtonRenderProps) => ReactNode);
  className?: string | ((renderProps: ButtonRenderProps) => string);
  /** Size scale. @default 'md' */
  size?: "sm" | "md" | "lg";
  /** Visual style. @default 'primary' */
  variant?: "primary" | "secondary" | "outline" | "ghost";
}

/**
 * TODO: One-line description of what {{pascalCase name}}Item does. Interactive subpart rendered
 * inside `{{pascalCase name}}`. Carries its own modifier props — modifiers live on the subpart that
 * actually renders the visual state.
 */
const {{pascalCase name}}Item = (props: Readonly<{{pascalCase name}}ItemProps>) => {
  const { children, className, ref, size, variant, ...rest } = props;

  const baseClassName = classes({
    block: "{{dashCase name}}-item",
    modifiers: {
      variant,
      size,
      disabled: rest.isDisabled,
    },
  });

  const itemClassName = composeRenderProps(className, (consumerClassName) =>
    clsx(baseClassName, consumerClassName),
  );

  return (
    <AriaComponent data-slot="{{dashCase name}}-item" className={itemClassName} ref={ref} {...rest}>
      {children}
    </AriaComponent>
  );
};

{{pascalCase name}}Item.displayName = "{{pascalCase name}}Item";

export { {{pascalCase name}}, {{pascalCase name}}Item };

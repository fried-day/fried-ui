@layer components {
  .{{dashCase name}} {
    @apply inline-flex items-center justify-center;
    @apply leading-none font-medium whitespace-nowrap select-none;

    --{{dashCase name}}-bg: var(--color-primary);
    --{{dashCase name}}-border: var(--color-primary-border);
    --{{dashCase name}}-fg: var(--color-primary-foreground);

    @apply bg-(--{{dashCase name}}-bg) text-(--{{dashCase name}}-fg);
    @apply border border-(--{{dashCase name}}-border);
    @apply h-8 gap-1.5 px-3 text-sm;
    @apply rounded-md;
  }

  /*
   * Variant classes — override tokens only (no @apply border-X-border).
   * Consumer overrides ANY of these tokens in their :root to theme globally.
   * Add new variants by defining the 3 tokens above (bg/border/fg).
   * If a required token doesn't exist in packages/styles/src/tokens/colors.css, add it there first.
   */

  .{{dashCase name}}-primary {
    --{{dashCase name}}-bg: var(--color-primary);
    --{{dashCase name}}-border: var(--color-primary-border);
    --{{dashCase name}}-fg: var(--color-primary-foreground);
  }

  .{{dashCase name}}-secondary {
    --{{dashCase name}}-bg: var(--color-secondary);
    --{{dashCase name}}-border: var(--color-secondary-border);
    --{{dashCase name}}-fg: var(--color-secondary-foreground);
  }

  .{{dashCase name}}-accent {
    --{{dashCase name}}-bg: var(--color-accent);
    --{{dashCase name}}-border: var(--color-accent-border);
    --{{dashCase name}}-fg: var(--color-accent-foreground);
  }

  .{{dashCase name}}-success {
    --{{dashCase name}}-bg: var(--color-success);
    --{{dashCase name}}-border: var(--color-success-border);
    --{{dashCase name}}-fg: var(--color-success-foreground);
  }

  .{{dashCase name}}-warning {
    --{{dashCase name}}-bg: var(--color-warning);
    --{{dashCase name}}-border: var(--color-warning-border);
    --{{dashCase name}}-fg: var(--color-warning-foreground);
  }

  .{{dashCase name}}-danger {
    --{{dashCase name}}-bg: var(--color-danger);
    --{{dashCase name}}-border: var(--color-danger-border);
    --{{dashCase name}}-fg: var(--color-danger-foreground);
  }

  .{{dashCase name}}-info {
    --{{dashCase name}}-bg: var(--color-info);
    --{{dashCase name}}-border: var(--color-info-border);
    --{{dashCase name}}-fg: var(--color-info-foreground);
  }

  .{{dashCase name}} [slot="icon"],
  .{{dashCase name}} [slot="icon-start"],
  .{{dashCase name}} [slot="icon-end"] {
    @apply size-match-font;
  }

  .{{dashCase name}}-size-sm {
    @apply h-6 gap-1 px-2 text-xs;
  }

  .{{dashCase name}}-size-md {
    @apply h-8 gap-1.5 px-3 text-sm;
  }

  .{{dashCase name}}-size-lg {
    @apply h-10 gap-2 px-4 text-base;
  }

  .{{dashCase name}}-radius-none {
    @apply rounded-none;
  }

  .{{dashCase name}}-radius-sm {
    @apply rounded-sm;
  }

  .{{dashCase name}}-radius-md {
    @apply rounded-md;
  }

  .{{dashCase name}}-radius-lg {
    @apply rounded-lg;
  }

  .{{dashCase name}}-radius-full {
    @apply rounded-full;
  }
}
